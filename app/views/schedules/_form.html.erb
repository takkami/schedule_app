<div class="form-card">
  <%= form_with model: @schedule do |f| %>

    <div class="form-group">
      <label class="form-label">
        タイトル <span class="form-required">*</span>
      </label>
      <%= f.text_field :title, class: "form-input", placeholder: "タイトル" %>
      <%= render "shared/error", object: @schedule, field: :title %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label">
          開始日 <span class="form-required">*</span>
        </label>
        <%= f.text_field :start_date,
          class: "form-input",
          placeholder: "---- / -- / --",
          autocomplete: "off",
          value: @schedule.start_date&.strftime("%Y-%m-%d"),
          data: { controller: "flatpickr" } %>
        <%= render "shared/error", object: @schedule, field: :start_date %>
      </div>
      <div class="form-group">
        <label class="form-label">
          終了日 <span class="form-required">*</span>
        </label>
        <%= f.text_field :end_date,
          class: "form-input",
          placeholder: "---- / -- / --",
          autocomplete: "off",
          value: @schedule.end_date&.strftime("%Y-%m-%d"),
          data: { controller: "flatpickr" } %>
        <%= render "shared/error", object: @schedule, field: :end_date %>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label form-label--checkbox">
        <%= f.check_box :all_day, class: "form-checkbox" %>
        終日の場合はチェックを入れます
      </label>
    </div>

    <div class="form-group form-group--memo">
      <label class="form-label">スケジュールメモ</label>
      <%= f.text_area :memo, class: "form-textarea", placeholder: "メモを入力する" %>
      <%= render "shared/error", object: @schedule, field: :memo %>
    </div>

    <div class="form-actions">
      <%= link_to "キャンセル", schedules_path, class: "btn btn-secondary" %>
      <%= f.submit "保存", class: "btn btn-primary" %>
    </div>

  <% end %>
</div>